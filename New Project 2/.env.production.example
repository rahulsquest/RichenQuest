# RichenQuest — PRODUCTION environment (names and safe defaults only).
# Copy to .env on the production host and fill the blanks. Never commit the filled file.
#
# Every value below that is left blank is a deliberate gate: the app should fail
# loudly on a missing secret rather than start with a default.

# ── Frontend (PUBLIC — these are compiled into the browser bundle) ───────────
# Must be the real HTTPS API origin. A localhost value here ships a broken build.
VITE_API_BASE_URL=https://api.richenquest.com/api
VITE_APP_ENV=production
VITE_COMPANY_NAME=RichenQuest
VITE_SUPPORT_EMAIL=
VITE_SUPPORT_PHONE=
VITE_WHATSAPP_NUMBER=

# ── Backend ─────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=

# Comma-separated browser origins. Never '*' — and with credentials enabled a
# wildcard does not work at all, it only looks like it does.
CORS_ALLOWED_ORIGINS=https://app.richenquest.com

# 32+ random bytes: openssl rand -hex 32
# The server refuses to sign sessions without this rather than using a default.
SESSION_SECRET=

# ── Zoho (SERVER-SIDE ONLY — never prefix any of these with VITE_) ──────────
# India data centre. Do not substitute .com endpoints.
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_CRM_API_DOMAIN=https://www.zohoapis.in
ZOHO_CRM_CLIENT_ID=
ZOHO_CRM_CLIENT_SECRET=
ZOHO_CRM_REFRESH_TOKEN=
ZOHO_CRM_ORG_ID=
ZOHO_CRM_REDIRECT_URI=
ZOHO_WEBHOOK_SECRET=

# Zoho Books
ZOHO_BOOKS_ORG_ID=
ZOHO_BOOKS_AUTH_TOKEN=
ZOHO_BOOKS_API_DOMAIN=https://www.zohoapis.in/books/v3

# Zoho Bookings
ZOHO_BOOKINGS_SERVICE_ID=
ZOHO_BOOKINGS_STAFF_ID=
ZOHO_BOOKINGS_API_DOMAIN=https://www.zohoapis.in/bookings/v1/json

# Zoho WorkDrive
ZOHO_WORKDRIVE_ROOT_FOLDER_ID=
ZOHO_WORKDRIVE_API_DOMAIN=https://workdrive.zoho.in/api/v1

# Zoho Flow webhook URLs
ZOHO_FLOW_LEAD_WEBHOOK_URL=
ZOHO_FLOW_BOOKING_WEBHOOK_URL=
ZOHO_FLOW_DOCUMENT_WEBHOOK_URL=
ZOHO_FLOW_PAYMENT_WEBHOOK_URL=

# Phone verification (external SMS gateway)
SMS_PROVIDER_NAME=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
