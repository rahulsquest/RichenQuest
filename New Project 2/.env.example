# Frontend Environment Configuration (Safe / Public Variables Only)
# No secrets, API keys, or OAuth credentials should ever be stored here.
VITE_API_BASE_URL=/api
VITE_APP_ENV=development
VITE_SALESIQ_WIDGET_CODE=
VITE_COMPANY_NAME=RichenQuest
VITE_SUPPORT_EMAIL=admissions@richenquest.com
VITE_SUPPORT_PHONE=+91 76312 07948
VITE_WHATSAPP_NUMBER=+91 76312 07948

# Backend & Catalyst Configuration (For Serverless Functions / Dev Server)
# These are kept server-side inside Catalyst and never sent to the browser.
PORT=5000
NODE_ENV=development
CATALYST_PROJECT_ID=
CATALYST_PROJECT_DOMAIN=

# Zoho CRM Integration Configuration (Server-Side)
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_CRM_API_DOMAIN=https://www.zohoapis.in
ZOHO_CRM_CLIENT_ID=
ZOHO_CRM_CLIENT_SECRET=
ZOHO_CRM_REFRESH_TOKEN=
ZOHO_CRM_CODE=
ZOHO_CRM_ORG_ID=

# Zoho Flow Webhook URLs (Server-Side Trigger Boundary)
ZOHO_FLOW_LEAD_WEBHOOK_URL=
ZOHO_FLOW_BOOKING_WEBHOOK_URL=
ZOHO_FLOW_DOCUMENT_WEBHOOK_URL=
ZOHO_FLOW_PAYMENT_WEBHOOK_URL=

# Zoho Books Integration (Server-Side)
ZOHO_BOOKS_ORG_ID=
ZOHO_BOOKS_AUTH_TOKEN=

# Zoho WorkDrive Integration (Server-Side)
ZOHO_WORKDRIVE_ROOT_FOLDER_ID=

# Zoho Bookings Integration (Server-Side)
ZOHO_BOOKINGS_SERVICE_ID=
ZOHO_BOOKINGS_STAFF_ID=

# Webhook Secret for Verifying Inbound Zoho Events
ZOHO_WEBHOOK_SECRET=richenquest_zoho_secure_token_placeholder

# Phone Verification Provider (External SMS Gateway)
SMS_PROVIDER_NAME=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Session signing key — 32+ random bytes. REQUIRED.
# Without it the server refuses to sign sessions rather than using a default.
SESSION_SECRET=

# Comma-separated browser origins allowed to call this API. Never '*'.
CORS_ALLOWED_ORIGINS=http://localhost:3000
